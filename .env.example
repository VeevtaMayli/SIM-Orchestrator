# SIM-Orchestrator Configuration
# Copy this file to .env and fill in your values:
#   copy .env.example .env

# API Key for device authentication (must match SIM-Relay secrets.h)
# Minimum 32 characters
API_KEY=your-secret-api-key-min-32-characters-long

# Optional second key accepted alongside API_KEY (for zero-downtime rotation)
# API_KEY_NEXT=next-secret-api-key-min-32-characters-long

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Chat ID (from @userinfobot or channel ID like -100123456789)
TELEGRAM_CHAT_ID=123456789

# Time zone used to display times in Telegram messages (IANA id, default UTC)
# DISPLAY_TIMEZONE=Europe/Moscow

# Docker Image (optional locally, REQUIRED on the VPS for CI deployments)
# Leave commented for a local build. The CI deploy step runs `docker compose pull`,
# which only works when this points at the registry image.
# DOCKER_IMAGE=ghcr.io/veevtamayli/sim-orchestrator:latest
